# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
# MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrodrop?retryWrites=true&w=majority
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/agrodrop
MONGODB_URI=mongodb://localhost:27017/agrodrop
DB_NAME=agrodrop

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=change_this_to_a_random_64_char_string_in_production
JWT_EXPIRY=7d

# ============================================
# CORS Configuration
# ============================================
# In production, set this to your frontend domain:
# FRONTEND_URL=https://your-app.onrender.com
# CORS_ORIGIN=https://your-frontend-domain.com
FRONTEND_URL=http://localhost:8000
CORS_ORIGIN=*

# ============================================
# Seed Database on startup
# ============================================
SEED_DATABASE=false
